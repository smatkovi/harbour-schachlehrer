[Desktop Entry]
Name=Schachlehrer
Comment=Schach lernen: messen, spielen, Fehler finden, üben
Icon=harbour-schachlehrer
Exec=harbour-schachlehrer
Type=Application
Categories=Game;Education;
X-Sailfish-ApplicationType=Silica

[X-Sailjail]
# chess-spec/platform.md §5.3. Internet is for the Lichess tablebase query and,
# from M8 on, the Lichess Board API; Documents is only ever used for an import
# or export the user starts by hand. Secrets is the encrypted store the Lichess
# access token goes into (§3.3) — without it the app falls back to a file with
# 0600 and says so. Base.permission leaves disable-exec.inc commented out, so
# the Stockfish child process may be started (§1.9).
Permissions=Internet;Documents;Secrets;Bluetooth
OrganizationName=org.smatkovi
ApplicationName=harbour-schachlehrer
# Die Partie gegen ein zweites Gerät geht auch über Bluetooth, und dafür
# braucht es AF_BLUETOOTH-Sockets. Sailjails Seccomp-Filter lässt nur die
# Protokolle zu, die seine Berechtigungen nennen (Base "unix", Internet
# "inet,inet6,netlink"); bluetooth nennt keine, im Käfig scheitert also jeder
# RFCOMM-Socket mit "Operation not supported". Die Kennung oben bleibt, an ihr
# hängt der Pfad der Einstellungen.
Sandboxing=Disabled
